# AI Code Review Assistant — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın:
#   cp .env.example .env

# ----------------------------------------------------------------
# SEÇENEK 1: Groq (ÜCRETSİZ & HIZLI — https://console.groq.com)
# ----------------------------------------------------------------
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=groq/compound-mini

# ----------------------------------------------------------------
# SEÇENEK 2: Ollama (ÜCRETSİZ Local — internet gerekmez)
# ----------------------------------------------------------------
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:4b

# ----------------------------------------------------------------
# SEÇENEK 3: Google Gemini (ÜCRETSİZ Tier — https://aistudio.google.com)
# ----------------------------------------------------------------
# OPENAI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------
# SEÇENEK 4: OpenAI (Ücretli)
# ----------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
